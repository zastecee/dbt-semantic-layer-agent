# Copy to .env and fill in real values. Loaded automatically by adk_agent/agent.py via python-dotenv.
# NEVER put real secrets in this file — it is the committed template. Put real values in .env (gitignored).

# AWS Bedrock credentials/config used by the Google ADK agent (via LiteLLM).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Option A: use a named AWS CLI profile (requires ~/.aws/credentials).
AWS_PROFILE=default

# Option B: use explicit credentials instead of AWS_PROFILE (e.g. temporary
# STS credentials). Leave unset if using AWS_PROFILE.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=


